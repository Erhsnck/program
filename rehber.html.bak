<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rehber Öğretmen - Ders Yerleştirme</title>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');
    :root {
      --bg: #0b0c15;
      --surface: #121228;
      --surface-2: #18193a;
      --text: #e8e8f0;
      --text-dim: #9a9aad;
      --red: #ff4d6d;
      --red-soft: rgba(255, 77, 109, 0.12);
      --red-border: rgba(255, 77, 109, 0.35);
      --green: #3ecf8e;
      --blue: #4da8ff;
      --purple: #b388ff;
      --border: rgba(255,255,255,0.06);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: radial-gradient(1200px 800px at 10% -10%, #1a0b2e 0%, transparent 60%),
                  radial-gradient(1000px 700px at 110% 10%, #0b1a3e 0%, transparent 60%),
                  var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 40px 20px;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--border);
    }
    h1 { font-weight: 800; font-size: 28px; letter-spacing: -0.03em; }
    .badge {
      background: var(--surface-2); border: 1px solid var(--border);
      padding: 6px 14px; border-radius: 999px; font-size: 12px; color: var(--text-dim);
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .day-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    }
    @media (max-width: 900px) { .day-grid { grid-template-columns: 1fr; } }
    .day-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 20px; padding: 28px; box-shadow: 0 20px 60px rgba(0,0,0,.35);
      transition: box-shadow .3s ease;
    }
    .day-card:hover { box-shadow: 0 30px 80px rgba(0,0,0,.45); }
    .day-title {
      font-weight: 700; font-size: 18px; margin-bottom: 22px;
      display: flex; align-items: center; gap: 10px;
    }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
    .slot {
      position: relative;
      padding: 14px 16px; border-radius: 12px; margin-bottom: 8px;
      border: 1px solid transparent; background: var(--surface-2); cursor: pointer;
      transition: all .2s ease; overflow: hidden;
    }
    .slot.locked {
      background: var(--red-soft); border-color: var(--red-border);
      opacity: 0.75; pointer-events: none; cursor: not-allowed;
    }
    .slot.locked .time { color: var(--red); font-weight: 700; }
    .time { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; color: var(--text); }
    .label { font-size: 12px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; }
    .student-tag {
      display: inline-flex; align-items: center; gap: 6px; position: relative;
      margin-top: 6px; padding: 4px 10px; border-radius: 999px;
      background: var(--purple); color: #fff; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: filter .15s, transform .1s;
    }
    .student-tag:hover { filter: brightness(1.15); transform: translateY(-1px); }
    .delete-btn {
      display: inline-flex; align-items: center; justify-content: center; margin-left: auto;
      width: 20px; height: 20px; border-radius: 50%; background: var(--red); color: #fff;
      font-size: 10px; font-weight: 700; line-height: 1; cursor: pointer; border: 1px solid rgba(255,255,255,0.4);
      box-shadow: 0 2px 6px rgba(255,77,109,0.35); flex-shrink: 0;
      z-index: 2;
    }
    .delete-btn:hover { filter: brightness(1.15); transform: scale(1.1); }
    .empty-hint { font-size: 11px; color: var(--text-dim); margin-top: 6px; }
    /* Modal */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity .2s ease;
    }
    .modal-overlay.active { opacity: 1; pointer-events: auto; }
    .modal-box {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 24px; padding: 32px; width: 420px; max-width: 92vw;
      box-shadow: 0 40px 100px rgba(0,0,0,.5); transform: translateY(12px); transition: transform .25s ease;
    }
    .modal-overlay.active .modal-box { transform: translateY(0); }
    .modal-box h2 { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
    .modal-box .sub { font-size: 12px; color: var(--text-dim); margin-bottom: 22px; }
    .input-wrap { position: relative; }
    input {
      width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border);
      background: var(--surface-2); color: var(--text); font-size: 15px; outline: none; transition: border-color .2s;
    }
    input:focus { border-color: var(--purple); }
    .suggestions {
      list-style: none; margin-top: 6px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
      background: var(--surface); max-height: 220px; overflow-y: auto;
    }
    .suggestions li {
      padding: 10px 14px; cursor: pointer; font-size: 14px; border-bottom: 1px solid var(--border);
      transition: background .15s;
    }
    .suggestions li:hover { background: var(--surface-2); }
    .suggestions li:last-child { border-bottom: none; }
    .btn-group { display: flex; gap: 10px; margin-top: 24px; }
    button {
      flex: 1; padding: 12px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; font-size: 14px; transition: all .2s ease;
    }
    .btn-primary { background: var(--purple); color: #fff; }
    .btn-primary:hover { filter: brightness(1.1); }
    .btn-danger { background: var(--red); color: #fff; }
    .btn-danger:hover { filter: brightness(1.1); }
    .btn-secondary { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
    .btn-secondary:hover { background: rgba(255,255,255,0.05); }
    .legend { margin-top: 32px; display: flex; gap: 20px; align-items: center; font-size: 13px; color: var(--text-dim); }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .swatch { width: 16px; height: 16px; border-radius: 6px; }
    .swatch.red { background: var(--red); }
    .swatch.purple { background: var(--purple); }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1>Rehber Öğretmen - Ders Yerleştirme</h1>
        <p style="margin-top:4px;color:var(--text-dim);font-size:14px;">Boş saatlere tıklayın, öğrenci ismi girin. Kırmızı saatlere atama yapılamaz.</p>
      </div>
      <span class="badge">Pzt · Çar · Per</span>
    </header>

    <div class="day-grid" id="grid"></div>

    <div class="legend">
      <div class="legend-item"><span class="swatch red"></span> Meşgul (Kırmızı) — Atama Yapılamaz</div>
      <div class="legend-item"><span class="swatch purple"></span> Atanmış Öğrenci</div>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay" id="modal" onclick="if(event.target===this) closeModal()">
    <div class="modal-box">
      <h2>Öğrenci Ata</h2>
      <div class="sub" id="modal-sub">Pazartesi — 11:00 - 11:40</div>
      <div class="input-wrap">
        <input type="text" id="studentInput" placeholder="Öğrenci adı yazın..." autocomplete="off" oninput="filterSuggestions(this.value)">
        <input type="text" id="classInput" placeholder="Sınıf bilgisi (ör. 9-A)..." autocomplete="off" style="margin-top:8px;">
        <ul class="suggestions" id="suggestions"></ul>
      </div>
      <div class="btn-group">
        <button class="btn-secondary" id="btn-secondary" onclick="closeModal()">İptal</button>
        <button class="btn-primary" id="btn-primary" onclick="saveStudent()">Kaydet</button>
      </div>
    </div>
  </div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyA8XQsJxy9dLXEUqMIRvIJo6xY7ccriJUs",
      authDomain: "dersprog-76583.firebaseapp.com",
      databaseURL: "https://dersprog-76583-default-rtdb.firebaseio.com",
      projectId: "dersprog-76583",
      storageBucket: "dersprog-76583.firebasestorage.app",
      messagingSenderId: "119598409588",
      appId: "1:119598409588:web:12f395c69248f952926e21",
      measurementId: "G-C3KXNPHKMP"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    const günler = ["Pazartesi", "Çarşamba", "Perşembe"];
    const saatler = [
      { ders: "11:00 - 11:40", teneffüs: "11:40 - 11:50" },
      { ders: "11:50 - 12:30", teneffüs: "12:30 - 12:40" },
      { ders: "12:40 - 13:20", teneffüs: "13:20 - 13:30" },
      { ders: "13:30 - 14:10", teneffüs: "14:10 - 14:20" },
      { ders: "14:20 - 15:00", teneffüs: "15:00 - 15:10" },
    ];

    let selected = { gün: '', idx: 0, el: null };
    let ogrenciKayitlari = [];

    function renderGrid() {
      const grid = document.getElementById('grid');
      grid.innerHTML = '';
      günler.forEach(gün => {
        const card = document.createElement('div');
        card.className = 'day-card';
        const title = document.createElement('div');
        title.className = 'day-title';
        title.innerHTML = `<span class="dot"></span> ${gün}`;
        card.appendChild(title);

        saatler.forEach((blok, i) => {
          const slot = document.createElement('div');
          slot.className = 'slot';
          slot.innerHTML = `
            <div>
              <div class="time">${blok.ders}</div>
              <div class="label">${blok.teneffüs}</div>
              <div class="empty-hint" id="hint-${gün}-${i}">Atama yapmak için tıklayın</div>
            </div>
          `;
          slot.addEventListener('click', () => openModal(gün, i, slot, blok));
          card.appendChild(slot);
        });
        grid.appendChild(card);
      });
    }

    function openModal(gün, idx, el, blok) {
      selected = { gün, idx, el, blok, mode: 'ata' };
      document.getElementById('modal-sub').textContent = `${gün} — ${blok.ders}`;
      document.getElementById('studentInput').value = '';
      document.getElementById('classInput').value = '';
      document.getElementById('suggestions').innerHTML = '';
      updateModalUI();
      document.getElementById('modal').classList.add('active');
      setTimeout(() => document.getElementById('studentInput').focus(), 50);
    }

    function openEditModal(gün, idx, mevcutIsimEnc, mevcutSinifEnc) {
      selected = { gün, idx, el: null, blok: null, mode: 'duzenle', mevcutIsim: mevcutIsimEnc ? decodeURIComponent(mevcutIsimEnc) : '', mevcutSinif: mevcutSinifEnc ? decodeURIComponent(mevcutSinifEnc) : '' };
      const günler = ["Pazartesi", "Çarşamba", "Perşembe"];
      const saatler = [
        { ders: "11:00 - 11:40", teneffüs: "11:40 - 11:50" },
        { ders: "11:50 - 12:30", teneffüs: "12:30 - 12:40" },
        { ders: "12:40 - 13:20", teneffüs: "13:20 - 13:30" },
        { ders: "13:30 - 14:10", teneffüs: "14:10 - 14:20" },
        { ders: "14:20 - 15:00", teneffüs: "15:00 - 15:10" },
      ];
      const blok = saatler[idx];
      document.getElementById('modal-sub').textContent = `${gün} — ${blok.ders}`;
      document.getElementById('studentInput').value = selected.mevcutIsim || '';
      document.getElementById('classInput').value = selected.mevcutSinif || '';
      document.getElementById('suggestions').innerHTML = '';
      updateModalUI();
      document.getElementById('modal').classList.add('active');
      setTimeout(() => document.getElementById('studentInput').focus(), 50);
    }

    function updateModalUI() {
      const title = document.querySelector('.modal-box h2');
      const btnPrimary = document.getElementById('btn-primary');
      const btnSecondary = document.getElementById('btn-secondary');
      if (selected.mode === 'duzenle') {
        title.textContent = 'Öğrenciyi Düzenle';
        btnPrimary.innerHTML = 'Güncelle';
        btnSecondary.innerHTML = 'Sil';
        btnSecondary.onclick = deleteStudent;
        btnSecondary.className = 'btn-danger';
        btnPrimary.className = 'btn-primary';
      } else {
        title.textContent = 'Öğrenci Ata';
        btnPrimary.innerHTML = 'Kaydet';
        btnPrimary.onclick = saveStudent;
        btnSecondary.innerHTML = 'İptal';
        btnSecondary.onclick = closeModal;
        btnSecondary.className = 'btn-secondary';
      }
      btnPrimary.onclick = (selected.mode === 'duzenle') ? saveEdit : saveStudent;
    }

    function closeModal() {
      document.getElementById('modal').classList.remove('active');
      selected = { gün: '', idx: 0, el: null };
    }

    function filterSuggestions(query) {
      const list = document.getElementById('suggestions');
      list.innerHTML = '';
      if (!query.trim()) return;
      const matches = ogrenciKayitlari.filter(o => o.toLowerCase().includes(query.toLowerCase())).slice(0, 8);
      matches.forEach(m => {
        const li = document.createElement('li');
        li.textContent = m;
        li.onclick = () => {
          document.getElementById('studentInput').value = m;
          list.innerHTML = '';
        };
        list.appendChild(li);
      });
    }

    function saveEdit() {
      const val = document.getElementById('studentInput').value.trim();
      const sinif = document.getElementById('classInput').value.trim();
      if (!val) { alert('Öğrenci adı girin'); return; }
      if (!selected.gün) return;
      const key = `dersler/${selected.gün}/${selected.idx}`;
      db.ref(key).set({ isim: val, sinif: sinif });
      db.ref('ogrenciAdlari').once('value').then(snap => {
        let mevcut = snap.exists() ? Object.values(snap.val()) : [];
        if (!mevcut.includes(val)) {
          db.ref('ogrenciAdlari').push(val);
        }
      });
      closeModal();
    }

    function deleteStudent() {
      if (!selected.gün) return;
      const key = `dersler/${selected.gün}/${selected.idx}`;
      db.ref(key).remove();
      closeModal();
    }

    function saveStudent() {
      const val = document.getElementById('studentInput').value.trim();
      const sinif = document.getElementById('classInput').value.trim();
      if (!val) { alert('Öğrenci adı girin'); return; }
      if (!selected.gün) return;
      const key = `dersler/${selected.gün}/${selected.idx}`;
      db.ref(key).set({ isim: val, sinif: sinif });
      // Öğrenci ismini otomatik tamamla listesine kaydet (benzersiz kontrolü)
      db.ref('ogrenciAdlari').once('value').then(snap => {
        let mevcut = snap.exists() ? Object.values(snap.val()) : [];
        if (!mevcut.includes(val)) {
          db.ref('ogrenciAdlari').push(val);
        }
      });
      closeModal();
    }

    function loadOgrenciKayitlari() {
      db.ref('ogrenciAdlari').once('value').then(snap => {
        if (snap.exists()) ogrenciKayitlari = Object.values(snap.val());
      });
      db.ref('ogrenciAdlari').on('value', snap => {
        if (snap.exists()) ogrenciKayitlari = Object.values(snap.val());
      });
    }

    function deleteSlotStudent(gün, idx) {
      selected = { gün, idx, mode: 'duzenle', mevcutIsim: '', mevcutSinif: '' };
      deleteStudent();
    }

    function syncUI() {
      günler.forEach(gün => {
        saatler.forEach((_, i) => {
          const meşgulRef = db.ref(`meşgul/${gün}/${i}`);
          meşgulRef.on('value', snap => {
            const slot = document.querySelector(`#grid .day-card:nth-child(${günler.indexOf(gün)+1}) .slot:nth-child(${i+2})`);
            if (!slot) return;
            const isBusy = snap.exists() && snap.val() === true;
            if (isBusy) {
              slot.classList.add('locked');
            } else {
              slot.classList.remove('locked');
            }
          });

          const dersRef = db.ref(`dersler/${gün}/${i}`);
          dersRef.on('value', snap => {
            const slot = document.querySelector(`#grid .day-card:nth-child(${günler.indexOf(gün)+1}) .slot:nth-child(${i+2})`);
            const hint = document.getElementById(`hint-${gün}-${i}`);
            if (!slot || !hint) return;
            if (snap.exists() && snap.val()) {
              const veri = snap.val();
              const isimStr = (typeof veri === 'object' && veri !== null) ? (veri.isim || '') : veri;
              const sinifStr = (typeof veri === 'object' && veri !== null) ? (veri.sinif || '') : '';
              hint.innerHTML = `<span class="student-tag" data-action="edit" data-gun="${gün}" data-idx="${i}" data-isim="${encodeURIComponent(isimStr || '')}" data-sinif="${encodeURIComponent(sinifStr || '')}">${isimStr || ''}<span class="delete-btn" data-action="delete" data-gun="${gün}" data-idx="${i}">✕</span></span>`;
            } else {
              hint.textContent = 'Atama yapmak için tıklayın';
            }
          });
        });
      });
    }

    renderGrid();

    document.getElementById('grid').addEventListener('click', function(e) {
      const deleteBtn = e.target.closest('.delete-btn');
      if (deleteBtn) {
        e.stopPropagation();
        e.preventDefault();
        const gün = deleteBtn.getAttribute('data-gun');
        const idx = parseInt(deleteBtn.getAttribute('data-idx'), 10);
        deleteSlotStudent(gün, idx);
        return;
      }
      const studentTag = e.target.closest('.student-tag');
      if (studentTag) {
        e.stopPropagation();
        e.preventDefault();
        const gün = studentTag.getAttribute('data-gun');
        const idx = parseInt(studentTag.getAttribute('data-idx'), 10);
        const isim = decodeURIComponent(studentTag.getAttribute('data-isim') || '');
        const sinif = decodeURIComponent(studentTag.getAttribute('data-sinif') || '');
        openEditModal(gün, idx, isim, sinif);
        return;
      }
    });

    loadOgrenciKayitlari();
    syncUI();
  </script>
</body>
</html>
